# Audio files (don't commit test fixtures or production samples by accident)
*.ds2
*.dss
*.DS2
*.DSS
*.mp3
*.wav
*.m4a
*.ogg

# ...with an explicit exception for the FATE sample we ship for upstream
# FFmpeg submission (public test artefact, not a production file).
!ffmpeg-upstream/fate/*.ds2
!ffmpeg-upstream/fate/*.DS2

# ...and for the small public samples the vendored codec's tests decode
# (copies of the FATE samples above, plus the Grundig fixture and its reference).
!ffmpeg-upstream/fate/*.dss
!vendor/test_files/*
!vendor/dss-codec/tests/fixtures/*

# Built by .github/workflows/pages.yml at deploy time (and by hand, see web/README.md)
web/pkg/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# Python (packaging build artefacts)
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/

# Rust build artefacts (if anyone builds the native binary locally)
target/

# Runtime / OS
*.log
*.pid
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo
*~
.*.kate-swp

# Build / install temporaries
tmp/
build/
dist/
*.tmp

# Local-only overrides (config with credentials, never commit)
*.local.conf
*.local.env
.env
.env.local
src/etc/audio-cron.conf
!src/etc/audio-cron.conf.example

# Briefs de travail internes : notes de session, chemins locaux, rien de publiable.
BRIEF-*.md

# Shared tool settings are versioned; per-machine ones (settings.local.json) are not
!.claude/
.claude/*
!.claude/settings.json
!.claude/CLAUDE.md
